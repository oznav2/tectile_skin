  "transcription_notes_he": [
    "\u05e2\u05e8\u05db\u05d9 W1/S1/D1 \u05de\u05d5\u05e2\u05ea\u05e7\u05d9\u05dd \u05dc\u05dc\u05d0 \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea: \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea\u05d9\u05d4\u05dd \u05d0\u05d9\u05e0\u05df \u05de\u05d5\u05d3\u05e4\u05e1\u05d5\u05ea \u05d1\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05e7\u05d5\u05e8, \u05d5\u05d0\u05d9\u05df \u05dc\u05d4\u05e0\u05d9\u05d7 mil.",
    "\u05d4\u05e2\u05e8\u05da 0.5 \u05d1\u05e9\u05d3\u05d4 \u05e1\u05d1\u05d5\u05dc\u05ea \u05d4\u05e2\u05db\u05d1\u05d4 \u05de\u05d5\u05e4\u05d9\u05e2 \u05dc\u05dc\u05d0 \u05d9\u05d7\u05d9\u05d3\u05d4 \u05d0\u05d5 \u05e1\u05d9\u05de\u05df \u05d0\u05d7\u05d5\u05d6; \u05e0\u05e9\u05de\u05e8 \u05dc\u05dc\u05d0 \u05d4\u05e1\u05e7\u05d4.",
    "null \u05de\u05e6\u05d9\u05d9\u05df \u05ea\u05d0 \u05e8\u05d9\u05e7 \u05d1\u05de\u05e7\u05d5\u05e8; / \u05e0\u05e9\u05de\u05e8 \u05db\u05e1\u05d9\u05de\u05df \u05e0\u05e4\u05e8\u05d3 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05d0\u05e4\u05e1.",
    "0/100 \u05d4\u05d5\u05d0 \u05de\u05d5\u05e0\u05d4 \u05ea\u05d5\u05d5\u05d9\u05dd \u05e9\u05dc \u05e9\u05d3\u05d4 \u05d4\u05e2\u05e8\u05d5\u05ea \u05e8\u05d9\u05e7 \u05d1\u05de\u05de\u05e9\u05e7 \u05d4\u05de\u05e7\u05d5\u05e8, \u05d5\u05dc\u05d0 \u05e2\u05e8\u05da \u05d7\u05e9\u05de\u05dc\u05d9.",
    "\u05d0\u05d9\u05d5\u05e8\u05d9 \u05d7\u05ea\u05da \u05d6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea \u05e0\u05e9\u05de\u05e8\u05d9\u05dd \u05db\u05d7\u05d9\u05ea\u05d5\u05db\u05d9\u05dd \u05de\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05e7\u05d5\u05e8; \u05d0\u05d9\u05db\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05e8 \u05d0\u05d9\u05e0\u05d4 \u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05ea\u05de\u05dc\u05d5\u05dc \u05d0\u05de\u05d9\u05df \u05e9\u05dc \u05db\u05dc \u05e1\u05d9\u05de\u05e0\u05d9\u05d4\u05dd, \u05d5\u05dc\u05db\u05df \u05dc\u05d0 \u05e0\u05d5\u05d7\u05e9\u05d5 \u05e4\u05e8\u05d8\u05d9\u05dd.",
    "H/HOZ \u05d5\u05beH/H \u05e0\u05e9\u05de\u05e8\u05d9\u05dd \u05db\u05e1\u05d9\u05de\u05d5\u05e0\u05d9 \u05d7\u05d5\u05de\u05e8 \u05e9\u05dc \u05d4\u05de\u05e7\u05d5\u05e8; \u05dc\u05d0 \u05d1\u05d5\u05e6\u05e2\u05d4 \u05d4\u05de\u05e8\u05d4 \u05d0\u05d5 \u05d4\u05e8\u05d7\u05d1\u05d4 \u05e9\u05dc \u05d4\u05e1\u05d9\u05de\u05d5\u05e0\u05d9\u05dd."
  ]
}
